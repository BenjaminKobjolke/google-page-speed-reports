# Copy to .env and fill in. Real environment variables override these values.

# Optional but recommended: keyless requests share a tiny quota and often get HTTP 429.
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Default output folder when --out is not given (relative paths are relative to this repo).
PAGESPEED_REPORTS_DIR=reports

# Request timeout in seconds. Lighthouse runs remotely and can take a minute.
PAGESPEED_TIMEOUT=120

# DEBUG, INFO, WARNING or ERROR. Logs go to stderr; stdout carries the report.
PAGESPEED_LOG_LEVEL=INFO
