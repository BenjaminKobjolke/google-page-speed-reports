  40: 
  41: def test_parse_response_rejects_runtime_error(psi_body: str) -> None:
  42:     data = json.loads(psi_body)
  43:     data["lighthouseResult"]["runtimeError"] = {"code": "NO_FCP", "message": "No content"}
  44:     with pytest.raises(PsiError, match="NO_FCP"):
  45:         parse_response(json.dumps(data))
  46: 
  47: 
  48: def test_parse_response_rejects_unexpected_shape() -> None:
  49:     with pytest.raises(PsiError):
  50:         parse_response('{"kind": "something else"}')
  51: 
  52: 
  53: def _http_error(code: int, message: str) -> urllib.error.HTTPError:
  54:     body = io.BytesIO(json.dumps({"error": {"message": message}}).encode())
  55:     return urllib.error.HTTPError("https://x", code, "err", {}, body)  # type: ignore[arg-type]
  56: 
  57: 
  58: def test_run_maps_429_to_quota_error(monkeypatch: pytest.MonkeyPatch) -> None:
  59:     def fake_urlopen(url: str, timeout: int) -> None:
  60:         raise _http_error(429, "Quota exceeded")
  61: 
  62:     monkeypatch.setattr("urllib.request.urlopen", fake_urlopen)
  63:     with pytest.raises(QuotaExceededError, match="Quota exceeded"):
  64:         PsiClient(SETTINGS).run("https://appcentrics.de/", Strategy.MOBILE)
  65: 
  66: 
  67: def test_run_sends_all_categories_and_key(monkeypatch: pytest.MonkeyPatch, psi_body: str) -> None:
  68:     requested: list[str] = []
  69: 
  70:     def fake_urlopen(url: str, timeout: int) -> io.BytesIO:
  71:         requested.append(url)
  72:         return io.BytesIO(psi_body.encode())
  73: 
  74:     monkeypatch.setattr("urllib.request.urlopen", fake_urlopen)
  75:     result = PsiClient(SETTINGS).run("https://appcentrics.de/", Strategy.DESKTOP)
  76:     assert result.requested_url == "https://appcentrics.de/"
  77:     for part in ("strategy=desktop", "category=best-practices", "category=seo", "key=secret"):
  78:         assert part in requested[0]
