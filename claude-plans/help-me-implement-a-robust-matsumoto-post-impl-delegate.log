  50:             **(os.environ if environ is None else environ),
  51:         }
  52:         reports_dir = Path(env.get(ENV_REPORTS_DIR) or DEFAULT_REPORTS_DIR)
  53:         if not reports_dir.is_absolute():
  54:             reports_dir = PROJECT_ROOT / reports_dir
  55:         timeout = env.get(ENV_TIMEOUT) or str(DEFAULT_TIMEOUT_SECONDS)
  56:         if not timeout.isdigit():
  57:             raise ValueError(f"{ENV_TIMEOUT} must be a whole number of seconds, got {timeout!r}")
  58:         return cls(
  59:             api_key=env.get(ENV_API_KEY) or None,
  60:             reports_dir=reports_dir,
  61:             timeout_seconds=int(timeout),
  62:             log_level=env.get(ENV_LOG_LEVEL) or DEFAULT_LOG_LEVEL,
  63:         )
===== src/pagespeed_report/app_logger.py =====
   1: """AppLogger: the single logging entry point. Logs go to stderr; stdout carries the report."""
   2: 
   3: import logging
   4: import sys
   5: 
   6: 
   7: class AppLogger:
   8:     _configured = False
   9: 
  10:     def __init__(self, name: str) -> None:
  11:         self._logger = logging.getLogger(name)
  12: 
  13:     @classmethod
  14:     def configure(cls, level: str) -> None:
  15:         if cls._configured:
  16:             return
  17:         logging.basicConfig(
  18:             level=level.upper(), stream=sys.stderr, format="%(levelname)s %(name)s: %(message)s"
  19:         )
  20:         cls._configured = True
  21: 
  22:     def debug(self, message: str) -> None:
  23:         self._logger.debug(message)
  24: 
  25:     def info(self, message: str) -> None:
  26:         self._logger.info(message)
  27: 
  28:     def warning(self, message: str) -> None:
  29:         self._logger.warning(message)
  30: 
  31:     def error(self, message: str) -> None:
  32:         self._logger.error(message)
===== src/pagespeed_report/models.py =====
   1: """Pydantic models for the subset of the PSI v5 / Lighthouse response this tool reads."""
   2: 
   3: from __future__ import annotations
   4: 
   5: from pydantic import BaseModel, ConfigDict, Field
   6: from pydantic.alias_generators import to_camel
   7: 
   8: 
   9: class PsiModel(BaseModel):
  10:     model_config = ConfigDict(alias_generator=to_camel, populate_by_name=True, extra="ignore")
  11: 
  12: 
  13: class NodeRef(PsiModel):
  14:     selector: str | None = None
  15:     snippet: str | None = None
  16:     node_label: str | None = None
  17: 
  18: 
  19: class DetailItem(PsiModel):
  20:     url: str | None = None
  21:     wasted_bytes: float | None = None
  22:     wasted_ms: float | None = None
  23:     node: NodeRef | None = None
  24:     # Lighthouse 12 "list" details nest whole tables as items.
  25:     items: list[DetailItem] = Field(default_factory=list)
  26: 
  27: 
  28: class AuditDetails(PsiModel):
  29:     type: str | None = None
  30:     overall_savings_ms: float | None = None
  31:     overall_savings_bytes: float | None = None
  32:     items: list[DetailItem] = Field(default_factory=list)
  33: 
  34: 
  35: class Audit(PsiModel):
  36:     id: str
  37:     title: str
  38:     description: str = ""
  39:     score: float | None = None
  40:     score_display_mode: str = ""
  41:     display_value: str | None = None
  42:     details: AuditDetails | None = None
  43:     metric_savings: dict[str, float] = Field(default_factory=dict)
  44: 
  45: 
  46: class AuditRef(PsiModel):
  47:     id: str
  48:     group: str | None = None
  49: 
  50: 
  51: class Category(PsiModel):
  52:     id: str
  53:     title: str
  54:     score: float | None = None
  55:     audit_refs: list[AuditRef] = Field(default_factory=list)
  56: 
  57: 
  58: class RuntimeErrorInfo(PsiModel):
  59:     code: str
  60:     message: str
  61: 
  62: 
  63: class LighthouseResult(PsiModel):
  64:     requested_url: str
  65:     final_displayed_url: str | None = None
  66:     fetch_time: str
  67:     runtime_error: RuntimeErrorInfo | None = None
  68:     categories: dict[str, Category]
  69:     audits: dict[str, Audit]
  70: 
  71: 
  72: class PsiResponse(PsiModel):
