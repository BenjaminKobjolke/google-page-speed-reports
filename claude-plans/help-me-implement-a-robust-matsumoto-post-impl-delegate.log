  14: 
  15: 
  16: def test_vitals_in_display_order_with_ratings(lighthouse_result: LighthouseResult) -> None:
  17:     vitals = analyze(lighthouse_result, Strategy.MOBILE).vitals
  18:     assert [(v.title, v.display_value, v.rating) for v in vitals] == [
  19:         ("Largest Contentful Paint", "5.1 s", Rating.POOR),
  20:         ("Cumulative Layout Shift", "0.002", Rating.GOOD),
  21:         ("Total Blocking Time", "120 ms", Rating.GOOD),
  22:         ("First Contentful Paint", "2.9 s", Rating.NEEDS_IMPROVEMENT),
  23:         ("Speed Index", "6.0 s", Rating.POOR),
  24:     ]
  25: 
  26: 
  27: def test_actions_sorted_by_savings_then_category(lighthouse_result: LighthouseResult) -> None:
  28:     actions = analyze(lighthouse_result, Strategy.MOBILE).actions
  29:     # Hidden-group duplicate, metrics, passing, informative and n/a audits are all excluded.
  30:     assert [a.audit_id for a in actions] == [
  31:         "unused-javascript",
  32:         "render-blocking-insight",
  33:         "image-alt",
  34:         "errors-in-console",
  35:         "meta-description",
  36:     ]
  37: 
  38: 
  39: def test_insight_savings_from_metric_savings_and_nested_items(
  40:     lighthouse_result: LighthouseResult,
  41: ) -> None:
  42:     action = analyze(lighthouse_result, Strategy.MOBILE).actions[1]
  43:     assert action.savings_ms == 450
  44:     assert [item.url for item in action.affected] == [
  45:         "https://appcentrics.de/css/main.css",
  46:         "https://fonts.googleapis.com/css2?family=Inter",
  47:     ]
  48: 
  49: 
  50: def test_affected_items_are_capped(lighthouse_result: LighthouseResult) -> None:
  51:     details = lighthouse_result.audits["unused-javascript"].details
  52:     assert details is not None
  53:     details.items = details.items * 7  # 14 items
  54:     action = analyze(lighthouse_result, Strategy.MOBILE).actions[0]
  55:     assert len(action.affected) == 10
  56:     assert action.more_affected == 4
  57: 
  58: 
  59: def test_rating_boundaries() -> None:
  60:     assert rating_for(0.9) is Rating.GOOD
  61:     assert rating_for(0.5) is Rating.NEEDS_IMPROVEMENT
  62:     assert rating_for(0.49) is Rating.POOR
