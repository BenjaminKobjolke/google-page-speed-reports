===== tools/graphify_update.bat =====
   1: @echo off
   2: setlocal enabledelayedexpansion
   3: REM ===========================================================================
   4: REM graphify_update.bat  --  TEMPLATE
   5: REM
   6: REM Manual, no-AI live-graph refresh + smoke test. Copy this into your
   7: REM project's  tools\  folder and adjust CODE_DIR below to your source folder
   8: REM (lib / src / app / internal ...). Run it after code changes or to check
   9: REM graphify works.
  10: REM
  11: REM What it does (no LLM, no API key, no token cost):
  12: REM   [1/2] Code-only AST refresh of the LIVE root graphify-out\graph.json via
  13: REM         `graphify update`. GRAPHIFY_OUT is pointed at the root folder and
  14: REM         CODE_DIR is passed absolute -- both required, otherwise the CLI
  15: REM         writes a stray graph under CODE_DIR\graphify-out\ or re-anchors
  16: REM         every node id. Directed flag + community labels are kept.
  17: REM         Docs are not re-extracted; a FIRST build is the skill flow
  18: REM              /graphify CODE_DIR --directed
  19: REM         inside Claude -- never delete graph.json before running this bat.
  20: REM   [2/2] Smoke test -- confirm the live root graph exists, is directed, and
  21: REM         answers a query. This is the "does graphify actually work here" check.
  22: REM ===========================================================================
  23: 
  24: REM ---- adjust this to your project's code folder -------------------------------
  25: set "CODE_DIR=src"
  26: REM -----------------------------------------------------------------------------
  27: 
  28: REM This bat lives in tools\ ; run everything from the repo root so graphify
  29: REM resolves the live graph at .\graphify-out\ (relative to cwd).
  30: pushd "%~dp0.."
  31: 
  32: REM Resolve the graphify launcher: prefer PATH, else derive from the interpreter
  33: REM the last build saved (graphify.exe sits next to that python.exe).
  34: set "GRAPHIFY=graphify"
  35: where graphify >nul 2>nul
  36: if errorlevel 1 (
  37:   if exist "graphify-out\.graphify_python" (
  38:     set /p GPY=<graphify-out\.graphify_python
  39:     set "GRAPHIFY=!GPY:python.exe=graphify.exe!"
  40:   ) else (
  41:     echo ERROR: graphify not on PATH and no graphify-out\.graphify_python found.
  42:     echo Build the graph once in Claude:  /graphify %CODE_DIR% --directed
  43:     popd & endlocal & exit /b 1
  44:   )
  45: )
  46: 
  47: echo === [1/2] live-graph AST refresh (no LLM) : %CODE_DIR% ===
  48: set "GRAPHIFY_OUT=%CD%\graphify-out"
  49: "%GRAPHIFY%" update "%CD%\%CODE_DIR%"
  50: echo.
  51: 
  52: echo === [2/2] smoke test: live root graph ===
  53: if not exist "graphify-out\graph.json" (
  54:   echo ERROR: graphify-out\graph.json not found.
  55:   echo Build it in Claude:  /graphify %CODE_DIR% --directed
  56:   popd & endlocal & exit /b 1
  57: )
  58: REM Report directed flag + node count of the LIVE root graph (should be directed:True).
  59: if exist "graphify-out\.graphify_python" (
  60:   set /p GPY2=<graphify-out\.graphify_python
  61:   "!GPY2!" -c "import json;d=json.load(open('graphify-out/graph.json',encoding='utf-8'));print('directed:',d.get('directed'),'  nodes:',len(d.get('nodes',[])))"
  62: )
  63: echo.
  64: echo --- god nodes (top 5) ---
  65: "%GRAPHIFY%" god-nodes --top 5
  66: echo.
  67: echo --- sample query ---
  68: "%GRAPHIFY%" query "What are the main modules and how do they connect?"
  69: 
  70: popd
  71: endlocal
