===== src/pagespeed_report/markdown_renderer.py =====
   1: """Render ReportData as Markdown written for an AI coding agent to act on."""
   2: 
   3: from pagespeed_report.analyzer import ActionItem, ReportData
   4: from pagespeed_report.models import DetailItem
   5: 
   6: BYTES_PER_KIB = 1024
   7: MS_PER_SECOND = 1000
   8: 
   9: 
  10: def format_ms(ms: float) -> str:
  11:     return f"{ms / MS_PER_SECOND:.1f} s" if ms >= MS_PER_SECOND else f"{round(ms)} ms"
  12: 
  13: 
  14: def format_bytes(size: float) -> str:
  15:     return f"{round(size / BYTES_PER_KIB)} KiB"
  16: 
  17: 
  18: def render(report: ReportData) -> str:
  19:     lines = [
  20:         f"# PageSpeed report: {report.url} ({report.strategy.value})",
  21:         "",
  22:         f"Tested: {report.fetch_time} via Google PageSpeed Insights (Lighthouse lab data). "
  23:         "PSI tests the public URL, so local changes show only after deploy.",
  24:         "",
  25:         "## Scores",
  26:         "",
  27:         "| Category | Score | Passed audits |",
  28:         "|---|---|---|",
  29:     ]
  30:     for score in report.scores:
  31:         value = "n/a" if score.score is None else str(score.score)
  32:         lines.append(f"| {score.title} | {value} | {score.passed_audits} |")
  33: 
  34:     lines += ["", "## Core Web Vitals (lab)", "", "| Metric | Value | Rating |", "|---|---|---|"]
  35:     lines += [f"| {v.title} | {v.display_value} | {v.rating.value} |" for v in report.vitals]
  36: 
  37:     lines += ["", f"## Action items ({len(report.actions)})", ""]
  38:     lines.append(
  39:         "Sorted by estimated time savings, then byte savings, then category."
  40:         if report.actions
  41:         else "No failing audits."
  42:     )
  43:     for index, action in enumerate(report.actions, start=1):
  44:         lines += ["", *_render_action(index, action)]
  45:     return "\n".join(lines) + "\n"
  46: 
  47: 
  48: def _render_action(index: int, action: ActionItem) -> list[str]:
  49:     savings = [format_ms(action.savings_ms)] if action.savings_ms else []
  50:     savings += [format_bytes(action.savings_bytes)] if action.savings_bytes else []
  51:     heading = f"### {index}. [{action.category_id}] {action.title}"
  52:     if savings:
  53:         heading += f": est. savings {' / '.join(savings)}"
  54:     lines = [heading, "", f"- Audit id: `{action.audit_id}`"]
  55:     if action.display_value:
  56:         lines.append(f"- Lighthouse says: {action.display_value}")
  57:     if action.description:
  58:         lines.append(f"- Why: {action.description}")
  59:     if action.affected:
  60:         lines.append("- Affected:")
  61:         lines += [f"  - {_render_item(item)}" for item in action.affected]
  62:         if action.more_affected:
  63:             lines.append(f"  - +{action.more_affected} more")
  64:     return lines
  65: 
  66: 
  67: def _render_item(item: DetailItem) -> str:
  68:     if item.url:
  69:         label = item.url
  70:     else:
  71:         node = item.node
  72:         selector = node.selector if node else None
  73:         label = f"selector `{selector}`" if selector else "element"
  74:         if node and node.snippet:
  75:             label += f": `{node.snippet}`"
  76:     wasted = [format_bytes(item.wasted_bytes)] if item.wasted_bytes else []
  77:     wasted += [format_ms(item.wasted_ms)] if item.wasted_ms else []
  78:     return f"{label} ({' / '.join(wasted)} wasted)" if wasted else label
