===== src/pagespeed_report/psi_client.py =====
   1: """HTTP client for the PageSpeed Insights v5 API."""
   2: 
   3: import json
   4: import urllib.error
   5: import urllib.parse
   6: import urllib.request
   7: 
   8: from pydantic import ValidationError
   9: 
  10: from pagespeed_report.app_logger import AppLogger
  11: from pagespeed_report.constants import CATEGORIES, PSI_ENDPOINT, QUOTA_HTTP_STATUS, Strategy
  12: from pagespeed_report.models import LighthouseResult, PsiResponse
  13: from pagespeed_report.settings import Settings
  14: 
  15: _log = AppLogger(__name__)
  16: 
  17: 
  18: class PsiError(Exception):
  19:     """The PSI request failed or returned an unusable result."""
  20: 
  21: 
  22: class QuotaExceededError(PsiError):
  23:     """PSI answered HTTP 429; keyless requests share a small anonymous quota."""
  24: 
  25: 
  26: def normalize_target(target: str) -> str:
  27:     """`appcentrics.de` -> `https://appcentrics.de/`. Rejects non-http(s) schemes."""
  28:     target = target.strip()
  29:     if "://" not in target:
  30:         target = f"https://{target}"
  31:     parsed = urllib.parse.urlsplit(target)
  32:     if parsed.scheme not in ("http", "https") or not parsed.hostname:
  33:         raise ValueError(f"Not an http(s) URL or domain: {target!r}")
  34:     return urllib.parse.urlunsplit(parsed._replace(path=parsed.path or "/"))
  35: 
  36: 
  37: class PsiClient:
  38:     def __init__(self, settings: Settings) -> None:
  39:         self._settings = settings
  40: 
  41:     def run(self, url: str, strategy: Strategy) -> LighthouseResult:
  42:         params: list[tuple[str, str]] = [("url", url), ("strategy", strategy.value)]
  43:         params += [("category", category) for category in CATEGORIES]
  44:         if self._settings.api_key:
  45:             params.append(("key", self._settings.api_key))
  46:         request_url = f"{PSI_ENDPOINT}?{urllib.parse.urlencode(params)}"
  47:         _log.info(f"Running PageSpeed Insights ({strategy.value}) for {url} ...")
  48:         try:
  49:             with urllib.request.urlopen(
  50:                 request_url, timeout=self._settings.timeout_seconds
  51:             ) as response:
  52:                 body = response.read()
  53:         except urllib.error.HTTPError as error:
  54:             message = _error_message(error)
  55:             if error.code == QUOTA_HTTP_STATUS:
  56:                 raise QuotaExceededError(message) from error
  57:             raise PsiError(f"HTTP {error.code}: {message}") from error
  58:         except (urllib.error.URLError, TimeoutError) as error:
  59:             raise PsiError(f"Request failed: {error}") from error
  60:         return parse_response(body)
  61: 
  62: 
  63: def parse_response(body: bytes | str) -> LighthouseResult:
  64:     try:
  65:         result = PsiResponse.model_validate(json.loads(body)).lighthouse_result
  66:     except (json.JSONDecodeError, ValidationError) as error:
  67:         raise PsiError(f"Unexpected PSI response: {error}") from error
  68:     if result.runtime_error and result.runtime_error.code != "NO_ERROR":
  69:         raise PsiError(
  70:             f"Lighthouse could not test the page: {result.runtime_error.code}: "
  71:             f"{result.runtime_error.message}"
  72:         )
  73:     return result
  74: 
  75: 
  76: def _error_message(error: urllib.error.HTTPError) -> str:
  77:     try:
  78:         return str(json.loads(error.read())["error"]["message"])
  79:     except (ValueError, KeyError, TypeError):
  80:         return str(error.reason)
===== src/pagespeed_report/analyzer.py =====
   1: """Turn a Lighthouse result into the report data: scores, vitals and sorted action items."""
   2: 
   3: from dataclasses import dataclass
   4: 
   5: from pagespeed_report.constants import (
   6:     AVERAGE_SCORE,
   7:     CATEGORIES,
   8:     MAX_AFFECTED_ITEMS,
   9:     NON_SCORED_MODES,
  10:     PASS_SCORE,
  11:     SKIPPED_GROUPS,
  12:     VITAL_AUDIT_IDS,
  13:     Rating,
  14:     Strategy,
  15: )
  16: from pagespeed_report.models import Audit, DetailItem, LighthouseResult
  17: 
  18: 
  19: @dataclass(frozen=True)
  20: class CategoryScore:
  21:     category_id: str
  22:     title: str
  23:     score: int | None
  24:     passed_audits: int
  25: 
  26: 
  27: @dataclass(frozen=True)
  28: class Vital:
  29:     title: str
  30:     display_value: str
  31:     rating: Rating
  32: 
  33: 
  34: @dataclass(frozen=True)
  35: class ActionItem:
  36:     category_id: str
  37:     audit_id: str
  38:     title: str
  39:     description: str
  40:     display_value: str | None
  41:     savings_ms: float
  42:     savings_bytes: float
  43:     affected: list[DetailItem]
  44:     more_affected: int
  45: 
  46: 
  47: @dataclass(frozen=True)
  48: class ReportData:
  49:     url: str
  50:     strategy: Strategy
  51:     fetch_time: str
  52:     scores: list[CategoryScore]
  53:     vitals: list[Vital]
  54:     actions: list[ActionItem]
  55: 
  56: 
  57: def rating_for(score: float) -> Rating:
  58:     if score >= PASS_SCORE:
  59:         return Rating.GOOD
  60:     return Rating.NEEDS_IMPROVEMENT if score >= AVERAGE_SCORE else Rating.POOR
  61: 
  62: 
  63: def is_failing(audit: Audit) -> bool:
  64:     return (
  65:         audit.score is not None
  66:         and audit.score_display_mode not in NON_SCORED_MODES
  67:         and audit.score < PASS_SCORE
  68:     )
  69: 
  70: 
  71: def analyze(result: LighthouseResult, strategy: Strategy) -> ReportData:
  72:     scores: list[CategoryScore] = []
  73:     actions: list[ActionItem] = []
  74:     seen: set[str] = set()
  75:     for category_id in CATEGORIES:
  76:         category = result.categories.get(category_id)
  77:         if category is None:
  78:             continue
  79:         passed = 0
  80:         for ref in category.audit_refs:
  81:             audit = result.audits.get(ref.id)
  82:             if audit is None or ref.group in SKIPPED_GROUPS or ref.id in seen:
  83:                 continue
  84:             seen.add(ref.id)
  85:             if is_failing(audit):
  86:                 actions.append(_action_item(category_id, audit))
  87:             elif audit.score is not None and audit.score_display_mode not in NON_SCORED_MODES:
  88:                 passed += 1
  89:         score = None if category.score is None else round(category.score * 100)
  90:         scores.append(CategoryScore(category_id, category.title, score, passed))
  91: 
  92:     category_order = {category_id: index for index, category_id in enumerate(CATEGORIES)}
  93:     actions.sort(
  94:         key=lambda a: (-a.savings_ms, -a.savings_bytes, category_order[a.category_id], a.title)
  95:     )
  96:     return ReportData(
  97:         url=result.final_displayed_url or result.requested_url,
  98:         strategy=strategy,
  99:         fetch_time=result.fetch_time,
 100:         scores=scores,
 101:         vitals=_vitals(result),
 102:         actions=actions,
 103:     )
 104: 
 105: 
 106: def _vitals(result: LighthouseResult) -> list[Vital]:
 107:     vitals: list[Vital] = []
 108:     for audit_id in VITAL_AUDIT_IDS:
 109:         audit = result.audits.get(audit_id)
 110:         if audit is not None and audit.score is not None and audit.display_value:
 111:             vitals.append(Vital(audit.title, audit.display_value, rating_for(audit.score)))
 112:     return vitals
 113: 
 114: 
 115: def _action_item(category_id: str, audit: Audit) -> ActionItem:
 116:     details = audit.details
 117:     savings_ms = details.overall_savings_ms if details else None
 118:     if savings_ms is None:
 119:         # Lighthouse 12 insight audits report savings per metric only; CLS is unitless, not ms.
 120:         savings_ms = max((v for k, v in audit.metric_savings.items() if k != "CLS"), default=0.0)
 121:     savings_bytes = (details.overall_savings_bytes if details else None) or 0.0
 122:     affected = _flatten(details.items) if details else []
 123:     return ActionItem(
 124:         category_id=category_id,
 125:         audit_id=audit.id,
 126:         title=audit.title,
 127:         description=audit.description,
 128:         display_value=audit.display_value,
 129:         savings_ms=savings_ms,
 130:         savings_bytes=savings_bytes,
 131:         affected=affected[:MAX_AFFECTED_ITEMS],
 132:         more_affected=max(0, len(affected) - MAX_AFFECTED_ITEMS),
 133:     )
 134: 
 135: 
 136: def _flatten(items: list[DetailItem]) -> list[DetailItem]:
 137:     """Keep items that name a resource or DOM node; unwrap nested tables."""
 138:     flat: list[DetailItem] = []
 139:     for item in items:
 140:         if item.url or item.node:
 141:             flat.append(item)
 142:         flat.extend(_flatten(item.items))
 143:     return flat
===== src/pagespeed_report/markdown_renderer.py =====
   1: """Render ReportData as Markdown written for an AI coding agent to act on."""
   2: 
   3: from pagespeed_report.analyzer import ActionItem, ReportData
   4: from pagespeed_report.models import DetailItem
   5: 
   6: BYTES_PER_KIB = 1024
   7: MS_PER_SECOND = 1000
   8: 
   9: 
  10: def format_ms(ms: float) -> str:
  11:     return f"{ms / MS_PER_SECOND:.1f} s" if ms >= MS_PER_SECOND else f"{round(ms)} ms"
  12: 
  13: 
  14: def format_bytes(size: float) -> str:
  15:     return f"{round(size / BYTES_PER_KIB)} KiB"
  16: 
  17: 
  18: def render(report: ReportData) -> str:
  19:     lines = [
  20:         f"# PageSpeed report: {report.url} ({report.strategy.value})",
  21:         "",
  22:         f"Tested: {report.fetch_time} via Google PageSpeed Insights (Lighthouse lab data). "
  23:         "PSI tests the public URL, so local changes show only after deploy.",
  24:         "",
  25:         "## Scores",
  26:         "",
  27:         "| Category | Score | Passed audits |",
  28:         "|---|---|---|",
  29:     ]
  30:     for score in report.scores:
  31:         value = "n/a" if score.score is None else str(score.score)
  32:         lines.append(f"| {score.title} | {value} | {score.passed_audits} |")
  33: 
  34:     lines += ["", "## Core Web Vitals (lab)", "", "| Metric | Value | Rating |", "|---|---|---|"]
  35:     lines += [f"| {v.title} | {v.display_value} | {v.rating.value} |" for v in report.vitals]
  36: 
  37:     lines += ["", f"## Action items ({len(report.actions)})", ""]
  38:     lines.append(
  39:         "Sorted by estimated time savings, then byte savings, then category."
  40:         if report.actions
  41:         else "No failing audits."
  42:     )
  43:     for index, action in enumerate(report.actions, start=1):
  44:         lines += ["", *_render_action(index, action)]
  45:     return "\n".join(lines) + "\n"
  46: 
  47: 
  48: def _render_action(index: int, action: ActionItem) -> list[str]:
  49:     savings = [format_ms(action.savings_ms)] if action.savings_ms else []
  50:     savings += [format_bytes(action.savings_bytes)] if action.savings_bytes else []
  51:     heading = f"### {index}. [{action.category_id}] {action.title}"
  52:     if savings:
  53:         heading += f": est. savings {' / '.join(savings)}"
  54:     lines = [heading, "", f"- Audit id: `{action.audit_id}`"]
  55:     if action.display_value:
  56:         lines.append(f"- Lighthouse says: {action.display_value}")
  57:     if action.description:
  58:         lines.append(f"- Why: {action.description}")
  59:     if action.affected:
  60:         lines.append("- Affected:")
  61:         lines += [f"  - {_render_item(item)}" for item in action.affected]
  62:         if action.more_affected:
  63:             lines.append(f"  - +{action.more_affected} more")
  64:     return lines
  65: 
  66: 
  67: def _render_item(item: DetailItem) -> str:
  68:     if item.url:
  69:         label = item.url
  70:     else:
  71:         node = item.node
  72:         selector = node.selector if node else None
  73:         label = f"selector `{selector}`" if selector else "element"
  74:         if node and node.snippet:
  75:             label += f": `{node.snippet}`"
  76:     wasted = [format_bytes(item.wasted_bytes)] if item.wasted_bytes else []
  77:     wasted += [format_ms(item.wasted_ms)] if item.wasted_ms else []
  78:     return f"{label} ({' / '.join(wasted)} wasted)" if wasted else label
===== src/pagespeed_report/cli.py =====
   1: """Command line entry point: run PSI for a URL and write Markdown reports."""
   2: 
   3: import argparse
   4: import io
   5: import sys
   6: from datetime import datetime
   7: from pathlib import Path
   8: from urllib.parse import urlsplit
   9: 
  10: from pagespeed_report.analyzer import analyze
  11: from pagespeed_report.app_logger import AppLogger
  12: from pagespeed_report.constants import (
  13:     ENV_API_KEY,
  14:     ENV_FILE_NAME,
  15:     EXIT_ERROR,
  16:     EXIT_OK,
  17:     EXIT_QUOTA,
  18:     Strategy,
  19: )
  20: from pagespeed_report.markdown_renderer import render
  21: from pagespeed_report.psi_client import PsiClient, PsiError, QuotaExceededError, normalize_target
  22: from pagespeed_report.settings import PROJECT_ROOT, Settings
  23: 
  24: BOTH = "both"
  25: _log = AppLogger(__name__)
  26: 
  27: 
  28: def parse_args(argv: list[str] | None) -> argparse.Namespace:
  29:     parser = argparse.ArgumentParser(
  30:         prog="pagespeed-report",
  31:         description="Google PageSpeed Insights report as Markdown for AI coding agents.",
  32:     )
  33:     parser.add_argument("target", help="Domain or URL, e.g. appcentrics.de")
  34:     parser.add_argument(
  35:         "--strategy",
  36:         choices=[*(s.value for s in Strategy), BOTH],
  37:         default=BOTH,
  38:         help="Device to emulate (default: both)",
  39:     )
  40:     parser.add_argument("--out", type=Path, help="Output folder (default: PAGESPEED_REPORTS_DIR)")
  41:     return parser.parse_args(argv)
  42: 
  43: 
  44: def report_path(out_dir: Path, url: str, strategy: Strategy, now: datetime) -> Path:
  45:     host = urlsplit(url).hostname or "unknown-host"
  46:     return out_dir / host / f"{now:%Y-%m-%d_%H%M}_{strategy.value}.md"
  47: 
  48: 
  49: def main(argv: list[str] | None = None, client: PsiClient | None = None) -> int:
  50:     args = parse_args(argv)
  51:     if isinstance(sys.stdout, io.TextIOWrapper):
  52:         # Windows consoles default to cp1252; reports contain arbitrary page snippets.
  53:         sys.stdout.reconfigure(encoding="utf-8")
  54:     try:
  55:         settings = Settings.load()
  56:         url = normalize_target(args.target)
  57:     except ValueError as error:
  58:         AppLogger.configure("INFO")
  59:         _log.error(str(error))
  60:         return EXIT_ERROR
  61:     AppLogger.configure(settings.log_level)
  62:     client = client or PsiClient(settings)
  63:     out_dir: Path = args.out or settings.reports_dir
  64:     strategies = list(Strategy) if args.strategy == BOTH else [Strategy(args.strategy)]
  65:     now = datetime.now()
  66: 
  67:     for strategy in strategies:
  68:         try:
  69:             report = analyze(client.run(url, strategy), strategy)
  70:         except QuotaExceededError as error:
  71:             _log.error(
  72:                 f"PSI quota exceeded: {error}\nSet {ENV_API_KEY} in {PROJECT_ROOT / ENV_FILE_NAME} "
  73:                 "(free key: https://developers.google.com/speed/docs/insights/v5/get-started)."
  74:             )
  75:             return EXIT_QUOTA
  76:         except PsiError as error:
  77:             _log.error(str(error))
  78:             return EXIT_ERROR
  79:         markdown = render(report)
  80:         path = report_path(out_dir, url, strategy, now)
  81:         path.parent.mkdir(parents=True, exist_ok=True)
  82:         path.write_text(markdown, encoding="utf-8")
  83:         sys.stdout.write(markdown + "\n")
  84:         _log.info(f"Report saved: {path}")
  85:     return EXIT_OK
  86: 
  87: 
  88: if __name__ == "__main__":
  89:     sys.exit(main())
