{
  "log_level": "all",
  "fail_on": "warning",
  "global_exclude_paths": [
    ".venv",
    ".git",
    "__pycache__",
    "tickets",
    "tmp",
    "code_analysis_results",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    "graphify-out"
  ],
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100
  },
  "pmd_similar_code": {
    "enabled": false,
    "minimum_tokens": 100,
    "ignore_identifiers": true,
    "ignore_literals": true,
    "ignore_annotations": false
  },
  "ruff_analyze": {
    "enabled": true,
    "select": ["E", "F", "I", "UP", "B"],
    "ignore": []
  }
}
